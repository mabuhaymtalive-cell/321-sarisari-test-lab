
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTestOwner() {
      return signedIn()
        && request.auth.uid == 'ViCadvue0IM7qWO7br5gm0Wzyng1';
    }

    function isAnonymousCustomer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validCustomer() {
      let c = request.resource.data.customer;
      return c is map
        && c.keys().hasAll(['name', 'phone', 'address', 'area'])
        && c.keys().hasOnly(['name', 'phone', 'address', 'area'])
        && c.name is string && c.name.size() >= 2 && c.name.size() <= 100
        && c.phone is string && c.phone.size() >= 7 && c.phone.size() <= 30
        && c.address is string && c.address.size() <= 300
        && c.area in [
          'San Carlos City Proper',
          'Vallehermoso',
          'Canlaon City',
          'Don Salvador Benedicto (DSB)',
          'Calatrava',
          'Toboso',
          'Store Pickup'
        ]
        && (c.area == 'Store Pickup' || c.address.size() >= 3);
    }

    function catalogItemMatches(i) {
      let product = get(
        /databases/$(database)/documents/publicCatalog/$(i.productId)
      );
      return product.data.active == true
        && product.data.name == i.name
        && product.data.unit == i.unit
        && product.data.price == i.unitPrice;
    }

    function validOneItem(i) {
      return i is map
        && i.keys().hasAll([
          'productId', 'name', 'unit',
          'quantity', 'unitPrice', 'lineTotal'
        ])
        && i.keys().hasOnly([
          'productId', 'name', 'unit',
          'quantity', 'unitPrice', 'lineTotal'
        ])
        && i.productId is string
        && i.productId.size() > 0
        && i.productId.size() <= 150
        && i.name is string
        && i.name.size() > 0
        && i.name.size() <= 150
        && i.unit is string
        && i.unit.size() > 0
        && i.unit.size() <= 40
        && i.quantity is int
        && i.quantity >= 1
        && i.quantity <= 99
        && i.unitPrice is number
        && i.unitPrice >= 0
        && i.lineTotal is number
        && i.lineTotal >= 0
        && i.lineTotal >= (i.unitPrice * i.quantity) - 0.000001
        && i.lineTotal <= (i.unitPrice * i.quantity) + 0.000001
        && catalogItemMatches(i);
    }

    function validItems() {
      let a = request.resource.data.items;
      return a is list
        && a.size() >= 1
        && a.size() <= 5
        && validOneItem(a[0])
        && (a.size() < 2 || validOneItem(a[1]))
        && (a.size() < 3 || validOneItem(a[2]))
        && (a.size() < 4 || validOneItem(a[3]))
        && (a.size() < 5 || validOneItem(a[4]));
    }

    function calculatedSubtotal() {
      let a = request.resource.data.items;
      let total = a[0].lineTotal
        + (a.size() > 1 ? a[1].lineTotal : 0)
        + (a.size() > 2 ? a[2].lineTotal : 0)
        + (a.size() > 3 ? a[3].lineTotal : 0)
        + (a.size() > 4 ? a[4].lineTotal : 0);

      return request.resource.data.subtotal is number
        && request.resource.data.subtotal >= total - 0.000001
        && request.resource.data.subtotal <= total + 0.000001;
    }

    function validCustomerOrderCreate() {
      let d = request.resource.data;

      return isAnonymousCustomer()
        && d.keys().hasAll([
          'customerUid', 'customer', 'items', 'subtotal',
          'deliveryFee', 'paymentMethod', 'paymentStatus',
          'paymentSenderName', 'paymentSenderNumber',
          'buyerPaymentReference', 'paymentAmount',
          'notes', 'status', 'riderId', 'riderName',
          'salesAttributionStatus', 'createdAt', 'source'
        ])
        && d.keys().hasOnly([
          'customerUid', 'customer', 'items', 'subtotal',
          'deliveryFee', 'paymentMethod', 'paymentStatus',
          'paymentSenderName', 'paymentSenderNumber',
          'buyerPaymentReference', 'paymentAmount',
          'notes', 'status', 'riderId', 'riderName',
          'salesAttributionStatus', 'createdAt', 'source'
        ])
        && d.customerUid == request.auth.uid
        && validCustomer()
        && validItems()
        && calculatedSubtotal()
        && d.deliveryFee is number
        && d.deliveryFee == (
          d.customer.area == 'San Carlos City Proper' ? 30 : 0
        )
        && d.paymentMethod in [
          'COD', 'GCash', 'BDO Bank Transfer'
        ]
        && d.paymentStatus == 'Pending'
        && d.paymentSenderName is string
        && d.paymentSenderName.size() <= 100
        && d.paymentSenderNumber is string
        && d.paymentSenderNumber.size() <= 30
        && d.buyerPaymentReference is string
        && d.buyerPaymentReference.size() <= 80
        && d.paymentAmount is number
        && d.paymentAmount == 0
        && (
          d.paymentMethod == 'COD'
          ? (
            d.paymentSenderName == ''
            && d.paymentSenderNumber == ''
            && d.buyerPaymentReference == ''
          )
          : d.paymentSenderName.size() >= 2
        )
        && d.notes is string
        && d.notes.size() <= 500
        && d.status == 'New'
        && d.riderId == ''
        && d.riderName == ''
        && d.salesAttributionStatus == 'Pending owner review'
        && d.createdAt == request.time
        && d.source == 'online';
    }

    function onlyFeeFieldsChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'deliveryFee', 'deliveryFeeConfirmedAt'
        ])
        && changed.hasAll(['deliveryFeeConfirmedAt'])
        && resource.data.status == 'New'
        && !('deliveryFeeAccepted' in resource.data)
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.deliveryFee <= 100000
        && request.resource.data.deliveryFeeConfirmedAt == request.time
        && (
          resource.data.customer.area != 'Store Pickup'
          || request.resource.data.deliveryFee == 0
        );
    }

    function onlyCustomerQuoteAcceptanceChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let online = resource.data.paymentMethod in [
        'GCash', 'BDO Bank Transfer'
      ];

      return isAnonymousCustomer()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'New'
        && 'deliveryFeeConfirmedAt' in resource.data
        && !('deliveryFeeAccepted' in resource.data)
        && changed.hasOnly([
          'deliveryFeeAccepted',
          'deliveryFeeAcceptedAt',
          'paymentAmount',
          'postQuotePaymentReference'
        ])
        && changed.hasAll([
          'deliveryFeeAccepted',
          'deliveryFeeAcceptedAt'
        ])
        && request.resource.data.deliveryFeeAccepted == true
        && request.resource.data.deliveryFeeAcceptedAt == request.time
        && (
          (
            !online
            && !changed.hasAny([
              'paymentAmount', 'postQuotePaymentReference'
            ])
          )
          ||
          (
            online
            && changed.hasAll([
              'paymentAmount', 'postQuotePaymentReference'
            ])
            && request.resource.data.paymentAmount is number
            && request.resource.data.paymentAmount
              == resource.data.subtotal + resource.data.deliveryFee
            && request.resource.data.postQuotePaymentReference is string
            && request.resource.data.postQuotePaymentReference.size() >= 4
            && request.resource.data.postQuotePaymentReference.size() <= 80
          )
        );
    }

    function onlyPaymentVerificationChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'paymentStatus',
          'paymentVerifiedReference',
          'paymentVerifiedAt',
          'paymentVerifiedBy'
        ])
        && changed.hasAll([
          'paymentStatus',
          'paymentVerifiedReference',
          'paymentVerifiedAt',
          'paymentVerifiedBy'
        ])
        && resource.data.status == 'New'
        && resource.data.paymentMethod in [
          'GCash', 'BDO Bank Transfer'
        ]
        && resource.data.paymentStatus == 'Pending'
        && resource.data.deliveryFeeAccepted == true
        && request.resource.data.paymentStatus == 'Verified'
        && request.resource.data.paymentVerifiedReference is string
        && request.resource.data.paymentVerifiedReference.size() >= 4
        && request.resource.data.paymentVerifiedReference.size() <= 80
        && request.resource.data.paymentVerifiedAt == request.time
        && request.resource.data.paymentVerifiedBy == request.auth.uid;
    }

    function riderProfileIsEligible(riderId, riderName, riderRole) {
      let profile = get(
        /databases/$(database)/documents/riderProfiles/$(riderId)
      );

      return profile.data.approvalStatus == 'Approved'
        && profile.data.status == 'Active'
        && profile.data.name == riderName
        && profile.data.role == riderRole;
    }

    function eligibleRider(riderId, riderName, riderRole) {
      return riderId is string
        && riderId.size() > 0
        && riderName is string
        && riderName.size() > 0
        && riderRole in ['Rider', 'Rider/Salesman']
        && riderProfileIsEligible(riderId, riderName, riderRole);
    }

    function validStatusTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data.status;

      return (
        (
          resource.data.status == 'New'
          && next == 'Confirmed'
          && changed.hasOnly(['status', 'ownerConfirmedAt'])
          && changed.hasAll(['status', 'ownerConfirmedAt'])
          && request.resource.data.ownerConfirmedAt == request.time
          && 'deliveryFeeConfirmedAt' in resource.data
          && resource.data.deliveryFeeAccepted == true
          && (
            resource.data.paymentMethod == 'COD'
            || resource.data.paymentStatus == 'Verified'
          )
        )
        ||
        (
          resource.data.status == 'Confirmed'
          && next == 'Assigned'
          && changed.hasOnly([
            'status', 'riderId', 'riderName', 'riderRole',
            'assignedAt', 'salesAttributionStatus'
          ])
          && changed.hasAll([
            'status', 'riderId', 'riderName', 'riderRole', 'assignedAt'
          ])
          && eligibleRider(
            request.resource.data.riderId,
            request.resource.data.riderName,
            request.resource.data.riderRole
          )
          && request.resource.data.assignedAt == request.time
          && request.resource.data.salesAttributionStatus == 'Assigned to rider'
        )
        ||
        (
          resource.data.status == 'Assigned'
          && next == 'Assigned'
          && changed.hasOnly([
            'riderId', 'riderName', 'riderRole',
            'assignedAt', 'salesAttributionStatus'
          ])
          && changed.hasAny(['riderId', 'riderName', 'riderRole'])
          && changed.hasAll(['assignedAt'])
          && eligibleRider(
            request.resource.data.riderId,
            request.resource.data.riderName,
            request.resource.data.riderRole
          )
          && request.resource.data.assignedAt == request.time
          && request.resource.data.salesAttributionStatus == 'Assigned to rider'
        )
        ||
        (
          resource.data.status == 'Assigned'
          && next == 'Out for Delivery'
          && changed.hasOnly(['status', 'outForDeliveryAt'])
          && changed.hasAll(['status', 'outForDeliveryAt'])
          && request.resource.data.outForDeliveryAt == request.time
        )
        ||
        (
          resource.data.status == 'Out for Delivery'
          && next == 'Delivered'
          && changed.hasOnly([
            'status', 'deliveredAt', 'salesAttributionStatus'
          ])
          && changed.hasAll(['status', 'deliveredAt'])
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.salesAttributionStatus
            == 'Delivered — owner review required'
        )
        ||
        (
          resource.data.status in ['New', 'Confirmed', 'Assigned']
          && next == 'Cancelled'
          && changed.hasOnly([
            'status', 'cancelReason', 'cancelledAt',
            'salesAttributionStatus'
          ])
          && changed.hasAll(['status', 'cancelReason', 'cancelledAt'])
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() >= 1
          && request.resource.data.cancelReason.size() <= 300
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.salesAttributionStatus
            == 'Cancelled — no incentive'
        )
      );
    }

    match /publicCatalog/{productId} {
      allow get, list: if isAnonymousCustomer()
        && resource.data.active == true;
      allow create, update, delete: if isTestOwner();
    }

    match /customerOrders/{orderId} {
      allow create: if validCustomerOrderCreate();

      allow get: if isTestOwner()
        || (
          isAnonymousCustomer()
          && resource.data.customerUid == request.auth.uid
        );

      allow list: if isTestOwner();

      allow update: if (
        isTestOwner()
        && (
          onlyFeeFieldsChanged()
          || onlyPaymentVerificationChanged()
          || validStatusTransition()
        )
      ) || onlyCustomerQuoteAcceptanceChanged();

      allow delete: if false;
    }

    match /storeProducts/{productId} {
      allow read, write: if isTestOwner();
    }

    match /storeSettings/{settingsId} {
      allow read, write: if isTestOwner();
    }

    match /riderProfiles/{uid} {
      allow read, write: if isTestOwner();
    }

    match /riderAttendance/{attendanceId} {
      allow read, write: if isTestOwner();
    }

    match /riderAssignments/{assignmentId} {
      allow read, write: if isTestOwner();
    }

    match /storeSales/{saleId} {
      allow read, write: if isTestOwner();
    }

    match /riderOrders/{orderId} {
      allow read, write: if false;
    }

    match /deliverySecrets/{orderId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
